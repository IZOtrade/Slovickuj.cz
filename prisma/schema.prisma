generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  decks         Deck[]
  settings      UserSettings?
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Deck {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  words       Word[]
  practiceRounds PracticeRound[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId, updatedAt])
}

model Word {
  id        String   @id @default(cuid())
  en        String
  cz        String
  category  String?
  deckId    String
  deck      Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  progress  WordProgress?
  reviews   PracticeReview[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deckId])
}

model UserSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode      String   @default("mix")
  autoPlay  Boolean  @default(false)
  speechRate Float   @default(1)
  updatedAt DateTime @updatedAt
}

model WordProgress {
  wordId         String   @id
  word           Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  lastRating     String
  reviewCount    Int      @default(0)
  knownCount     Int      @default(0)
  unsureCount    Int      @default(0)
  unknownCount   Int      @default(0)
  knownStreak    Int      @default(0)
  lastReviewedAt DateTime
  nextReviewAt   DateTime
}

model PracticeRound {
  id             String   @id
  deckId         String
  deck           Deck     @relation(fields: [deckId], references: [id], onDelete: Cascade)
  mode           String
  totalWords     Int
  reviewedCount  Int      @default(0)
  knownCount     Int      @default(0)
  unsureCount    Int      @default(0)
  unknownCount   Int      @default(0)
  startedAt      DateTime @default(now())
  lastReviewedAt DateTime @default(now())
  finishedAt     DateTime?
  reviews        PracticeReview[]

  @@index([deckId, lastReviewedAt])
}

model PracticeReview {
  id        String   @id
  roundId   String
  round     PracticeRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  wordId    String?
  word      Word?    @relation(fields: [wordId], references: [id], onDelete: SetNull)
  rating    String
  direction String
  createdAt DateTime @default(now())

  @@unique([roundId, wordId])
  @@index([wordId, createdAt])
}
